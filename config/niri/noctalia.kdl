layout {

    focus-ring {
        active-color   "#d8b9ff"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d8b9ff"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#d8b9ff"
        inactive-color "#573486"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d8b9ff80"
    }
}

recent-windows {
    highlight {
        active-color "#d8b9ff"
        urgent-color "#ffb4ab"
    }
}
